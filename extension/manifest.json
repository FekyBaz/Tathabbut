{
  "manifest_version": 3,
  "name": "Tathabbut — تثبّت",
  "version": "0.1.0",
  "description": "A reversible, user-controlled text filter for social feeds.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.facebook.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tathabbut settings",
    "default_popup": "popup.html"
  }
}
